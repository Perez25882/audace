# Leave both values blank for an illustrations-only storefront.
# Obtain these from your own Supabase project's API settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only key for isolated pending-order integration or trusted Phase 4 operations.
# The storefront and administrator sign-in do not require this key.
SUPABASE_SERVICE_ROLE_KEY=

# Set the actual app origin. Loopback HTTP is supported for local admin cookies.
AUDACE_APP_ORIGIN=http://127.0.0.1:3000

# Payment processing is restricted to test mode.
PAYSTACK_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=
# Explicitly list the merchant-enabled hosted channels, e.g. card,mobile_money.
PAYSTACK_CHANNELS=
# timestamped uses whsec_ signing secrets. Set legacy only for a documented legacy integration.
PAYSTACK_WEBHOOK_MODE=timestamped
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_WEBHOOK_SECRET_PREVIOUS=
# Optional account identifier, checked when returned by Paystack.
PAYSTACK_INTEGRATION_ID=
# Random server-only bearer secret for the scheduled reconciliation endpoint.
PAYMENT_RECONCILE_SECRET=

# Set only after the founder approves the public domain. No guessed canonical host.
AUDACE_PUBLIC_ORIGIN=
# Staging and local previews remain excluded from indexing by default.
AUDACE_INDEXING_ENABLED=false
